# SEC requires a contact header. Requests without it get a 403.
SEC_USER_AGENT="Your Name your@email.com"

# SEC hard cap is 10 req/s per IP; 8 leaves headroom.
SEC_RATE_LIMIT_RPS=8

# Prices only. Fundamentals come from EDGAR — do not pay for them.
TIINGO_API_KEY=

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

DATA_DIR=data
CACHE_TTL_HOURS=24
